# ==============================================================================
# Quiz Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in the project root and populate with your credentials.
# Note: Vite reads `VITE_*` variables at build time and in development from the root.
# ==============================================================================

# ============================================
# 1. Frontend Configuration (Client / Vite)
# ============================================

# Primary API Base URL
# - Development: /api (proxied via Vite dev server to http://localhost:5000)
# - Production (Monolith/Vercel): /api
# - Production (Decoupled frontend): https://your-backend-api.koyeb.app/api
VITE_API_URL=/api

# Fallback API URL (Optional, for high-availability dual-backend setups)
# When the primary API fails, requests can automatically failover to this URL
# VITE_FALLBACK_API_URL=https://fallback-api.vercel.app/api

# Client API Resilience & Retry Settings (Optional)
# VITE_API_TIMEOUT=10000
# VITE_API_RETRY_ATTEMPTS=3
# VITE_API_RETRY_DELAY=1000
# VITE_API_RETRY_BACKOFF=2
# VITE_API_HEALTH_CHECK_INTERVAL=30000

# Google OAuth 2.0 Client ID (Required for Google Single Sign-On)
# Create credentials in Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins must include your client URL (e.g. http://localhost:5173)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Real-time WebSocket / Socket.io Configuration (Optional)
# In development, defaults to http://localhost:5000.
# On serverless platforms (e.g. Vercel), sockets are disabled by default unless an external URL is set.
# VITE_SOCKET_URL=http://localhost:5000
# VITE_SOCKET_PATH=/socket.io/
# VITE_ENABLE_SOCKET=true

# Supabase Client Integration (Optional - falls back to localStorage if empty)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key


# ============================================
# 2. Server & Runtime Configuration
# ============================================

# Server Listening Port (Default: 5000)
PORT=5000

# Application Environment ('development' | 'production')
NODE_ENV=development

# Allowed Client Origin for CORS (Required)
# Development: http://localhost:5173
# Production: https://your-frontend-domain.com
CLIENT_URL=http://localhost:5173

# Local Development Mode (Optional)
# Set to 'true' to bypass API rate limiting during local development / testing
LOCAL_DEV=true


# ============================================
# 3. Authentication & Security
# ============================================

# JSON Web Token (JWT) Secret (Required)
# IMPORTANT: In production, this must be a high-entropy string with a MINIMUM of 32 characters.
# Generate one using: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long


# ============================================
# 4. Database Configuration (MongoDB)
# ============================================

# Toggle Local MongoDB vs Cloud Atlas
# Set to 'true' to force using LOCAL_MONGODB_URI in non-cloud environments
USE_LOCAL_DB=true

# Local MongoDB Connection String
LOCAL_MONGODB_URI=mongodb://127.0.0.1:27017/quiz-platform

# Primary MongoDB Connection String (Required)
# In local development: mongodb://127.0.0.1:27017/quiz-platform
# In production (Atlas): mongodb+srv://<username>:<password>@<cluster>.mongodb.net/quiz-platform?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/quiz-platform

# MongoDB Atlas Connection String (Optional fallback / used by cloud seeders)
ATLAS_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/quiz-platform?retryWrites=true&w=majority


# ============================================
# 5. AI Services (Groq Cloud)
# ============================================

# Groq API Key (Required for AI Quiz Generation, Studio, & Code Evaluation)
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model Identifier
# Recommended options:
# - llama-3.3-70b-versatile (Best balance of quality and speed)
# - qwen/qwen3.6-27b
# - llama-3.1-8b-instant
# - mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile


# ============================================
# 6. Code Execution API (Judge0 CE)
# ============================================

# Judge0 CE Configuration (Required for Interactive Code Playground & Compiler)
# Subscribe at RapidAPI: https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_API_KEY=your_rapidapi_key_here
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com/submissions
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com


# ============================================
# 7. Support & Email Service (Nodemailer)
# ============================================

# Destination inbox for user support tickets & contact messages
SUPPORT_EMAIL_TO=support@example.com

# Friendly "From" address for sent notification emails
EMAIL_FROM="Quiz Platform Support" <support@quizplatform.com>

# Email Delivery Method (Choose Option 1 or Option 2 below)

# Option 1: Direct Gmail Service (Recommended for quick setup)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=your-16-char-app-password

# Option 2: Standard SMTP Server (SendGrid, Mailgun, Brevo, AWS SES, Resend, etc.)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password


# ============================================
# 8. Admin Seeder Credentials
# ============================================
# Used by `npm run seed:admin` and `npm run seed` to provision the initial superadmin
ADMIN_USER_ID=admin
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@quizplatform.local
ADMIN_PASSWORD=change-me-to-a-strong-password-before-seeding


# ============================================
# 9. Serverless & Deployment Proxy (Vercel / Koyeb)
# ============================================
# Used by the Vercel serverless proxy (api/[...path].js) to route traffic to Koyeb backend
# BACKEND_URL=https://your-koyeb-backend.koyeb.app


# ============================================
# 10. Build & Diagnostics (Optional)
# ============================================
# Bundle visualizer analyzer flag (used with `npm run build:analyze`)
# ANALYZE=true
