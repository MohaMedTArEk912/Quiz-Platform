# ============================================
# Frontend Configuration
# ============================================

# API Base URL
# Development: /api (proxied)
# Production: https://your-backend-domain.com/api
VITE_API_URL=/api

# Google OAuth Client ID
# Get from Google Cloud Console: https://console.cloud.google.com/
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ============================================
# Backend/Server Configuration
# ============================================

# MongoDB Connection String (Required)
# Local: mongodb://127.0.0.1:27017/quiz-platform
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
USE_LOCAL_DB=true
LOCAL_MONGODB_URI=mongodb://127.0.0.1:27017/quiz-platform
MONGODB_URI=mongodb://127.0.0.1:27017/quiz-platform
ATLAS_MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=Cluster0

# JWT Secret (Required)
# Generate a secure random string (e.g., `openssl rand -hex 32`)
JWT_SECRET=your_secure_jwt_secret_key

# Groq AI Configuration (Required for AI features)
# Get API Key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key
# Production active models: qwen/qwen3.6-27b, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=qwen/qwen3.6-27b

# Judge0 CE Configuration (Required for Code Compiler)
# Get API Key from RapidAPI: https://rapidapi.com/judge0-official/api/judge0-ce
# Note: Use the 'ce' (Community Edition) endpoints unless you have a paid plan.
JUDGE0_API_KEY=your_rapidapi_key
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com/submissions
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# Server Port (Optional, default: 5000)
PORT=5000

# Client URL (Required for CORS)
# Production: https://your-frontend-domain.com
# Development: http://localhost:5173
CLIENT_URL=http://localhost:5173

# Environment (development/production)
NODE_ENV=development

# Admin Seeder (optional)
ADMIN_USER_ID=admin
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-seeding

# ============================================
# Support & Email Service Configuration (Nodemailer)
# ============================================
# Option 1: Gmail Service (Recommended for quick setup)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Option 2: Custom SMTP Server (SendGrid, Mailgun, Brevo, AWS SES, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Target inbox where support tickets are delivered (Default: mohaamedtariq12@gmail.com)
SUPPORT_EMAIL_TO=mohaamedtariq12@gmail.com
EMAIL_FROM="Quiz Platform Support" <support@quizplatform.com>

